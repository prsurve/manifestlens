{
  "name": "manifestlens-vscode",
  "displayName": "ManifestLens",
  "description": "Explains Kubernetes YAML in plain English and flags risky settings. Works offline.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "publisher": "prsurve",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#2f5bd6",
    "theme": "dark"
  },
  "homepage": "https://manifestlens-one.vercel.app",
  "bugs": {
    "url": "https://github.com/prsurve/manifestlens/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prsurve/manifestlens.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Education",
    "Other"
  ],
  "keywords": [
    "kubernetes",
    "yaml",
    "k8s",
    "lint",
    "security"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "manifestlens.explainFile",
        "title": "ManifestLens: Explain this manifest"
      },
      {
        "command": "manifestlens.fixFile",
        "title": "ManifestLens: Fix this manifest (preview first)"
      }
    ],
    "configuration": {
      "title": "ManifestLens",
      "properties": {
        "manifestlens.enable": {
          "type": "boolean",
          "default": true,
          "description": "Check Kubernetes manifests and show explanations on hover."
        },
        "manifestlens.rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra rule files or folders (YAML). Relative paths are resolved from the workspace folder."
        },
        "manifestlens.minimumSeverity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "default": "info",
          "description": "Hide findings below this severity."
        },
        "manifestlens.fixMaxRisk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "low",
          "description": "Highest risk applied by \"Fix this manifest\". The lightbulb quick fixes always offer every fix and show its risk."
        },
        "manifestlens.fixPolicy": {
          "type": "string",
          "default": "",
          "description": "YAML file with values for fixes that cannot guess them, for example params: { memoryLimit: 256Mi }. Relative paths are resolved from the workspace folder."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies -o dist/manifestlens.vsix",
    "publish:marketplace": "npm run build && vsce publish --no-dependencies"
  },
  "dependencies": {
    "@manifestlens/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  }
}
